# clangd config for Oscar64 C sources.
#
# These .c files target the Oscar64 compiler, NOT standard C. Oscar64
# ships its own headers (c64/vic.h, c64/rasterirq.h, etc.) and globals
# (vic, VCOL_*, RIRQCode). Standard clang has no idea about any of it
# and produces dozens of "file not found" / "undeclared identifier"
# diagnostics that are not real bugs.
#
# Suppress ALL clangd diagnostics for files under src/. The Oscar64
# compiler is the source of truth — verify build correctness via
# `make` (which invokes the real oscar64 binary), not via the LSP.
If:
  PathMatch: src/.*
Diagnostics:
  Suppress: '*'

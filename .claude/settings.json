{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check:listings*)",
      "Bash(node scripts/check-listings.ts*)",
      "Bash(node src/cli.ts *)",
      "Bash(npm run health*)",
      "Bash(npm run typecheck*)",
      "Bash(npm test*)",
      "Bash(npx vitest run*)",
      "Bash(java -jar *KickAss.jar*)",
      "Bash(oscar64 *)",
      "Bash(cl65 *)",
      "Bash(x64sc *)",
      "Bash(timeout * x64sc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run format*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-doc-edit.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-ts-edit.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh",
            "timeout": 180,
            "statusMessage": "Build and unit tests"
          }
        ]
      }
    ]
  }
}

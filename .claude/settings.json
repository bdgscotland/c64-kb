{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check:listings*)",
      "Bash(npx tsx scripts/check-listings.ts*)",
      "Bash(npx tsx src/cli.ts *)",
      "Bash(npx c64-kb health*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npm test*)",
      "Bash(npx vitest run*)",
      "Bash(java -jar *KickAss.jar*)",
      "Bash(oscar64 *)",
      "Bash(cl65 *)",
      "Bash(x64sc *)",
      "Bash(timeout * x64sc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-doc-edit.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-ts-edit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
